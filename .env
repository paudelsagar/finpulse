# ---------------------------
# Versions
# ---------------------------
CONFLUENT_VERSION=7.5.0
FLINK_VERSION=1.18.1-java11
ELASTIC_VERSION=7.17.0

# ---------------------------
# Hosts / Ports (External)
# ---------------------------
# Kafka
KAFKA_PORT=9092

# Flink
FLINK_UI_PORT=8081

# Elasticsearch
ES_PORT=9200

# Kibana
KIBANA_PORT=5601

# ClickHouse
CH_PORT=8123
CH_NATIVE_PORT=9000

# Flink Jars (Used by processor.py)
KAFKA_JAR=flink-sql-connector-kafka-3.0.1-1.18.jar
ES_JAR=flink-sql-connector-elasticsearch7-3.0.1-1.17.jar
CH_JAR=flink-connector-clickhouse-1.17-0.1.3-all.jar

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=fin-transaction
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
ELASTICSEARCH_URL=http://localhost:9200
CLICKHOUSE_URL=http://localhost:8123
