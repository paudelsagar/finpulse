FROM flink:1.18.1-java11

USER root

# Install Python 3, Pip, and JDK/Build Tools (for PyFlink ARM64 build)
RUN apt-get update -y && \
    apt-get install -y python3 python3-pip python3-dev openjdk-11-jdk-headless build-essential libssl-dev zlib1g-dev libbz2-dev libffi-dev && \
    ln -s /usr/bin/python3 /usr/bin/python

ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-arm64

# Install PyFlink
RUN pip3 install apache-flink==1.18.1
